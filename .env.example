# Copiar a frontend/.env.local para desarrollo. No poner secretos en variables NEXT_PUBLIC_.
# Obligatoria: URL base del backend en Render (sin barra final; se normaliza igual).
NEXT_PUBLIC_API_URL=https://rivera-backend.onrender.com
# mock = demostración local identificada | live = datos del backend
NEXT_PUBLIC_DATA_MODE=mock

# Opcionales (valores por defecto entre paréntesis)
# NEXT_PUBLIC_POLL_INTERVAL_MS=7000        # consulta HTTP; alinear con el envío del MKR (5–10 s)
# NEXT_PUBLIC_STALE_AFTER_MS=30000         # después de esto la lectura deja de estar "En vivo"
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS=20000     # Render puede tardar en despertar
# NEXT_PUBLIC_MAX_BACKOFF_MS=60000         # espera máxima entre reintentos
# NEXT_PUBLIC_HISTORY_MINUTES=60           # ventana de las gráficas
# NEXT_PUBLIC_TELEMETRY_TRANSPORT=poll     # poll | sse (sse requiere el endpoint del contrato)
# NEXT_PUBLIC_TELEMETRY_STREAM_PATH=/api/public/stream
# NEXT_PUBLIC_TIMEZONE=America/Managua
